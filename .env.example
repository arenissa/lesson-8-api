# === Шаблон переменных окружения для ВК-бота Алины (Zerocoder + GigaChat) ===
# Скопируй этот файл в .env и заполни СВОИМИ значениями вручную:
# Windows (PowerShell): Copy-Item .env.example .env
# Реальные ключи НЕ храни в коде и НЕ публикуй на GitHub.

# --- ВКонтакте (сообщество) ---
# Токен доступа сообщества: ВК -> Управление сообществом -> Работа с API -> Ключи доступа
# Нужны права: messages, photos, wall (минимум messages). Отвечает за чтение и отправку сообщений.
VK_GROUP_TOKEN=

# ID сообщества ВКонтакте (только цифры, без минуса и без "club").
# Где взять: Управление сообществом -> Настройки -> Адрес / ID, либо из ссылки вида vk.com/club123456
VK_GROUP_ID=

# --- GigaChat API (Сбер) ---
# Ключ авторизации GigaChat (Authorization key, Base64). Выдаётся в личном кабинете Sber Developers / GigaChat API.
# Используется как credentials="..." в Python SDK, обмен на access_token происходит автоматически.
GIGACHAT_CREDENTIALS=

# Scope доступа. Для физлиц: GIGACHAT_API_PERS. Для бизнеса: GIGACHAT_API_B2B или GIGACHAT_API_CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель генерации. Рекомендации из документации:
# GigaChat (Lite по умолчанию) - быстрые простые задачи,
# GigaChat-2 - баланс скорости и качества,
# GigaChat-2-Pro - сложные инструкции,
# GigaChat-2-Max - максимальное качество.
GIGACHAT_MODEL=GigaChat-2-Pro

# Базовый URL API для новых подключений. Менять обычно не нужно.
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# --- Дополнительно ---
# Ссылка на форму для связи с отделом продаж Zerocoder.
# Бот будет предлагать её в подходящий момент. Укажи реальную ссылку с сайта zerocoder.ru.
SALES_FORM_URL=https://zerocoder.ru/
